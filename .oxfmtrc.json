{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "ignorePatterns": ["public/**", ".agents/**", "src/routeTree.gen.ts"],
  "printWidth": 100,
  "semi": false,
  "singleQuote": false,
  "sortImports": true,
  "tabWidth": 2,
  "trailingComma": "all",
  "useTabs": false
}
